#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# pre-commit: コミット前に必ず走らせる検査
#
#   1. PHP 構文チェック（ステージされた PHP ファイル）
#   2. Moodle コーディング規約チェック (phpcs --standard=moodle)
#   3. テストがあれば実行 (PHPUnit)
#   4. ドキュメント更新のリマインド
#
# 有効化: git config core.hooksPath .githooks
# 緊急時の迂回: git commit --no-verify （常用しないこと）
# ---------------------------------------------------------------------------
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
rc=0

say()  { printf '%s\n' "$*"; }
fail() { printf '  ❌ %s\n' "$*"; rc=1; }
ok()   { printf '  ✅ %s\n' "$*"; }
skip() { printf '  ⏭  %s\n' "$*"; }

# ステージされた PHP ファイル（削除は除外）
mapfile -t STAGED_PHP < <(git diff --cached --name-only --diff-filter=ACMR -z \
  | tr '\0' '\n' | grep -E '\.php$' || true)

say "── 1. PHP 構文チェック ──────────────────────────"
if [ ${#STAGED_PHP[@]} -eq 0 ]; then
  skip "対象の PHP ファイルなし"
else
  for f in "${STAGED_PHP[@]}"; do
    [ -f "$REPO_ROOT/$f" ] || continue
    if ! out=$(php -l "$REPO_ROOT/$f" 2>&1); then
      fail "$f"; printf '     %s\n' "$out"
    fi
  done
  [ "$rc" = 0 ] && ok "${#STAGED_PHP[@]} ファイル 構文エラーなし"
fi

say "── 2. Moodle コーディング規約 (phpcs) ───────────"
PHPCS=""
for cand in "$REPO_ROOT/../../.tools/vendor/bin/phpcs" \
            "$REPO_ROOT/vendor/bin/phpcs" \
            "$(command -v phpcs 2>/dev/null || true)"; do
  [ -n "$cand" ] && [ -x "$cand" ] && { PHPCS="$cand"; break; }
done

if [ -z "$PHPCS" ]; then
  fail "phpcs が見つかりません。dev/.tools で composer require moodlehq/moodle-cs を実行してください"
  say  "     （規約チェックを飛ばしてコミットしないこと）"
elif [ ${#STAGED_PHP[@]} -eq 0 ]; then
  skip "対象の PHP ファイルなし"
else
  # ⚠ ステージされたファイルに直接 phpcs をかけると、コンポーネント名を
  #   解決できる状態でないと発火しない sniff（moodle.PHPUnit.TestCaseNames など）を
  #   取りこぼす。実際に 2026-09-12 の CI がこれで落ちた。
  #   deploy/lint.sh は 5.0 のソースツリーへ複製してから回すので、そちらを優先する。
  LINT="$REPO_ROOT/../../deploy/lint.sh"
  if [ -x "$LINT" ]; then
    if "$LINT" "$(basename "$REPO_ROOT")"; then
      ok "違反なし（deploy/lint.sh 経由・CI と同条件）"
    else
      fail "規約違反あり（phpcbf で自動修正できるものがあります）"
    fi
  else
    # 予備。lint.sh が無いときだけ、ステージされたファイルを直接見る。
    paths=()
    for f in "${STAGED_PHP[@]}"; do [ -f "$REPO_ROOT/$f" ] && paths+=("$REPO_ROOT/$f"); done
    if [ ${#paths[@]} -gt 0 ]; then
      if "$PHPCS" --standard=moodle --extensions=php "${paths[@]}"; then
        ok "違反なし（ただし一部の sniff は発火しません）"
      else
        fail "規約違反あり（phpcbf で自動修正できるものがあります）"
      fi
    fi
  fi
fi

say "── 3. テスト ────────────────────────────────────"
# ⚠ コンポーネントの置き場所は各コンポーネントの .moodlepath が持っているので、そこから数える。
#   （2026-09-26 に ai/provider/router を削除し、いまは local/airouter のみ。
#     数が変わっても直さずに済むよう、決め打ちしない）
mapfile -t COMPONENTS < <(
  find "$REPO_ROOT" -name .moodlepath -not -path '*/.git/*' -printf '%h\n' | sort |
  while read -r dir; do
    sed -n "s/^\$plugin->component *= *'\([^']*\)'.*/\1/p" "$dir/version.php" 2>/dev/null
  done
)
# ⚠ Moodle はテストを持つコンポーネントぶんしか testsuite を作らない。
#   持たないものを並べると phpunit がその場で失敗する。
mapfile -t SUITES < <(
  find "$REPO_ROOT" -name .moodlepath -not -path '*/.git/*' -printf '%h\n' | sort |
  while read -r dir; do
    [ -d "$dir/tests" ] || continue
    c="$(sed -n "s/^\$plugin->component *= *'\([^']*\)'.*/\1/p" "$dir/version.php" 2>/dev/null)"
    [ -n "$c" ] && echo "${c}_testsuite"
  done
)

if [ ${#COMPONENTS[@]} -eq 0 ]; then
  fail "コンポーネントが見つかりません（.moodlepath と version.php を確認してください）"
else
  # ⚠⚠ 作業ツリーをコンテナへ同期してから実行する。同期しないまま「通った」と
  #   報告した失敗が 2026-09-21 にあった（dev/実機検証メモ.md）。
  SYNC="$REPO_ROOT/../../deploy/sync-test.sh"
  TESTHOST="${MAJ_TESTHOST:-root@192.168.11.13}"
  if [ ! -x "$SYNC" ]; then
    fail "deploy/sync-test.sh が見つかりません"
  elif ! ssh -o ConnectTimeout=5 -o BatchMode=yes "$TESTHOST" true 2>/dev/null; then
    fail "テスト環境に到達できません（$TESTHOST / podman majtest）"
    say  "     （テストを実行せずにコミットしないこと）"
  elif ! "$SYNC" >/dev/null; then
    fail "テストコンテナへの同期に失敗しました"
  else
    ok "同期しました: ${COMPONENTS[*]}"
    suites="$(IFS=,; echo "${SUITES[*]}")"
    if [ -z "$suites" ]; then
      skip "テストを持つコンポーネントがありません"
    elif ssh "$TESTHOST" "podman exec -w /var/www/html majtest-php vendor/bin/phpunit --testsuite $suites"; then
      ok "PHPUnit green (${TESTHOST} / podman)"
    else
      fail "PHPUnit 失敗"
    fi
  fi
fi

say "── 4. ドキュメント ──────────────────────────────"
say "  変更内容に応じて更新したか確認してください:"
say "    - plugins/*/README.md      … 機能・要件・使い方が変わったとき"
say "    - dev/README.md            … ワークスペース構成・手順が変わったとき"
say "    - dev/実機検証メモ.md       … 実機で新しい仕様・落とし穴が判明したとき"
say "    - dev/対応バージョン方針.md … 対応バージョンやゲートの判断が動いたとき"
say "    - docs/*.md                … 設計判断・WBS・予算が動いたとき"
say "    - docs/経緯ログ.md          … 毎回（検討したこと・行ったことを追記。追記専用）"
say "    - docs/README.md           … docs/ にファイルを作成・改名・削除したとき"
say "    - STATE.md                 … ⛔ 指示されたときだけ（自動更新しない）"
docs_changed=$(git diff --cached --name-only --diff-filter=ACMR | grep -cE '\.md$' || true)
if [ "$docs_changed" -gt 0 ]; then
  ok "このコミットには .md の変更が $docs_changed 件含まれています"
else
  say "  ℹ️  このコミットに .md の変更はありません（不要ならそのままで問題ありません）"
fi

say "─────────────────────────────────────────────────"
if [ "$rc" != 0 ]; then
  say "コミットを中止しました。上の ❌ を解消してください。"
  say "自動修正: cd /root/maj_grant_2026/dev && ./deploy/lint.sh --fix"
fi
exit $rc
